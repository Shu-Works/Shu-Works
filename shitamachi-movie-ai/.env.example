# ─── APIキー（.env にコピーして実際の値を入れる。.env は絶対にコミットしない）───

# ステップ1: リサーチ・台本生成（Claude API — Web検索ツール利用）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ステップ2: 画像生成（DALL-E 3 / gpt-image-1）+ ステップ3: TTS/Whisper
OPENAI_API_KEY=sk-xxxxx

# ステップ3(代替): ElevenLabs（高品質TTS・タイムスタンプ付き）
# ELEVENLABS_API_KEY=xxxxx

# ステップ2(代替): FLUX via Replicate（DALL-E 3より安く高品質）
# REPLICATE_API_TOKEN=r8_xxxxx

# ─── 動作設定 ───
# TTSプロバイダ: "openai" or "elevenlabs"
TTS_PROVIDER=openai
# 画像プロバイダ: "codex"（Codexに委譲・デフォルト） or "dalle" / "flux"（API課金）
IMAGE_PROVIDER=codex
