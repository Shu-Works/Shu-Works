# =============================================================
#  メルマガ自動下書きツール 設定ファイル（雛形）
#  このファイルを .env にコピーして、値を埋めてください:
#      cp .env.example .env
#  .env は .gitignore 済み（Git にコミットされません）。
# =============================================================

# --- MailerLite（必須）---------------------------------------
# 取得: MailerLite 管理画面 → Integrations → API → Generate new token
MAILERLITE_API_KEY=

# 送信元（必須）。FROM_EMAIL は MailerLite で認証済みのドメイン/アドレスにすること
FROM_NAME=Your Colouring Studio
FROM_EMAIL=hello@yourdomain.com

# 配信先グループ ID（任意・推奨）
# 未指定でも下書きは作れますが、配信前に管理画面で受信者を選ぶ必要があります。
# 取得: 管理画面 → Subscribers → Groups → 対象グループの URL 末尾の数字
MAILERLITE_GROUP_ID=

# --- ブランド / 動線（必須に近い）-----------------------------
# CTA ボタンの遷移先（Shopify 商品ページ or CARRD など）
SHOP_URL=https://your-shop.myshopify.com
# CTA ボタンの文言
CTA_TEXT=Browse the colouring pages
# フッターに表示するブランド名
BRAND_NAME=Your Colouring Studio

# --- Claude / AI 文面生成（任意）------------------------------
# 設定すると Claude が毎回オリジナルの英語文面を生成します。
# 未設定なら themes.json の定番文面（テンプレート）で動作します。
# 取得: https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
# 使うモデル（既定: claude-opus-4-8。コスト重視なら claude-sonnet-4-6 等に変更可）
ANTHROPIC_MODEL=claude-opus-4-8

# --- ヘッダー画像（任意）-------------------------------------
# Pexels の無料 API キーを入れると、テーマに合った著作権フリー画像を自動選定します。
# 取得: https://www.pexels.com/api/
PEXELS_API_KEY=
# 画像を毎回固定したい場合は、ここに画像 URL を直接指定（Pexels より優先されます）
HEADER_IMAGE_URL=
