# =============================================================================
# WordPress SEO エージェント 設定サンプル
#
# 使い方:
#   cp .env.example .env
#   各値を実際のものに置き換える（.env は絶対に Git にコミットしないこと）
# =============================================================================

# -----------------------------------------------------------------------------
# Claude / Anthropic
# -----------------------------------------------------------------------------
# https://console.anthropic.com/ で発行した API キー
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル（省略時は claude-opus-4-8）
# 速度・コスト優先なら claude-sonnet-4-6 / claude-haiku-4-5 も可
SEO_AGENT_MODEL=claude-opus-4-8

# 監査の合格ライン（score がこの値以上 かつ pass=true で合格）。省略時 80
SEO_AGENT_PASS_SCORE=80

# 最大リライト回数（無限ループ防止）。省略時 3
SEO_AGENT_MAX_LOOPS=3

# -----------------------------------------------------------------------------
# 競合分析（任意）— 検索上位ページの構成を分析に取り込む
# -----------------------------------------------------------------------------
# プロバイダ: auto（既定・設定済みキーを自動採用）/ serpapi / google_cse / none
SEO_SEARCH_PROVIDER=auto

# 解析する上位件数（省略時 5）
SEO_COMPETITOR_TOP_N=5

# SerpAPI を使う場合（https://serpapi.com/）
SERPAPI_API_KEY=

# Google Custom Search JSON API を使う場合
# https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ※ どちらのキーも未設定なら競合分析は自動的にスキップされ、
#   LLM の内部知識のみで構成を設計します（従来動作）。

# -----------------------------------------------------------------------------
# WordPress（REST API + アプリケーションパスワード）
# -----------------------------------------------------------------------------
# サイトのベース URL（末尾スラッシュなし）
WORDPRESS_URL=https://example.com

# ログインユーザー名
WORDPRESS_USERNAME=admin

# 「ユーザー > プロフィール > アプリケーションパスワード」で生成した値。
# 表示される空白はそのまま貼り付けてよい（スクリプト側で除去する）。
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 既定で付与するカテゴリ／タグ（カンマ区切り、任意）。
# 存在しない名前は自動作成される。
WORDPRESS_DEFAULT_CATEGORIES=ブログ
WORDPRESS_DEFAULT_TAGS=
