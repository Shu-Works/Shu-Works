# ============================================================
# WordPress SEO Agent - 環境変数設定サンプル
# このファイルを .env にコピーして実際の値を入力してください
# ============================================================
# cp .env.example .env
# ============================================================

# ──────────────────────────────────────────────
# Anthropic API
# https://console.anthropic.com/settings/keys
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用するClaudeモデル（変更可能）
# 最新モデル一覧: claude-opus-4-8 / claude-sonnet-4-6 / claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# ──────────────────────────────────────────────
# WordPress 接続情報
# REST API + アプリケーションパスワードを使用
# ──────────────────────────────────────────────

# WordPressサイトのURL（末尾スラッシュ不要）
WP_URL=https://your-site.com

# WordPressのユーザー名
WP_USER=your_wp_username

# アプリケーションパスワード（取得方法は下記）
# WordPress管理画面 → ユーザー → プロフィール → アプリケーションパスワード
# 生成されたパスワードをそのまま（スペース含む形式でも可）貼り付ける
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ──────────────────────────────────────────────
# 将来拡張: SEO APIキー（オプション）
# ──────────────────────────────────────────────

# SerpAPI（競合検索結果取得）
# https://serpapi.com/
# SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DataForSEO（詳細なキーワード難易度・検索ボリューム）
# https://dataforseo.com/
# DATAFORSEO_LOGIN=your@email.com
# DATAFORSEO_PASSWORD=xxxxxxxxxx
